# Render supplies PORT automatically. Local default is 3000.
PORT=3000
NODE_ENV=development

# PostgreSQL: use Render's Internal Database URL in production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/naicts_infohub

# Generate a long random value. Never commit .env.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@naicts-infohub.local
ADMIN_PASSWORD=ChangeMeImmediately123!

# Cloudinary is used for persistent image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
