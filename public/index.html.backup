<section id="pro"><div class="section-head"><div><span class="eyebrow">OFFICIAL COMMUNICATION</span><h2>PRO Desk</h2></div></div><div id="pro-list" class="grid"></div></section>
<section id="events" class="soft"><div class="section-head"><div><span class="eyebrow">WHAT’S NEXT</span><h2>Upcoming Events</h2></div></div><div id="events-list" class="event-grid"></div></section>
<section id="media"><div class="section-head"><div><span class="eyebrow">VISUAL STORIES</span><h2>Media & Gallery</h2></div></div><div class="media-note"><img src="/assets/naicts-logo.jpg"><div><h3>Faculty moments, in one place.</h3><p>The media area is prepared for official photos and visual stories from NAICTS activities.</p></div></div></section></main>
